---
// Bandeau défilant des partenaires (accueil). Logos en couleur, défilement continu et fluide sur mobile.
import { partenaires } from '../data/site';
import { type Lang, tr } from '../i18n';
import { tailleLogo } from '../lib/logo';

interface Props { lang: Lang; }
const { lang } = Astro.props;

---
<div class="marquee" aria-label={lang === 'ar' ? 'شركاؤنا' : 'Nos partenaires'} dir="ltr">
  <div class="track">
    {[0, 1].map((copie) => (
      <ul class="set" aria-hidden={copie === 1 ? 'true' : undefined}>
        {partenaires.map((p) => (
          <li style={tailleLogo(p.ratio, 6000, 72, 170)}>
            <img src={p.logo} alt={copie === 0 ? tr(p.nom, lang) : ''} loading="eager" decoding="async" />
          </li>
        ))}
      </ul>
    ))}
  </div>
</div>

<style>
  .marquee { border-block: 1px solid var(--line); padding: 22px 0; overflow: hidden; background: #fff; }
  /* Deux copies identiques de la liste : on décale d'exactement une copie (-50 %) pour une boucle sans à-coup. */
  .track { display: flex; width: max-content; animation: defile var(--duree, 21s) linear infinite; will-change: transform; }
  .set { display: flex; align-items: center; list-style: none; margin: 0; padding: 0; }
  li { flex: none; width: var(--w); height: var(--h); margin: 0 32px; }
  img { display: block; width: 100%; height: 100%; object-fit: contain; }
  @keyframes defile { from { transform: translate3d(0, 0, 0); } to { transform: translate3d(-50%, 0, 0); } }
  /* Pause au survol uniquement avec une vraie souris : sur mobile, un toucher ne bloque plus le défilement. */
  @media (hover: hover) and (pointer: fine) { .marquee:hover .track { animation-play-state: paused; } }
  @media (max-width: 640px) {
    .marquee { padding: 16px 0; }
    .track { --duree: 13s; }
    li { width: calc(var(--w) * .68); height: calc(var(--h) * .68); margin: 0 18px; }
  }
  /* Si le visiteur a demandé « réduire les animations » : grille fixe, sans doublons. */
  @media (prefers-reduced-motion: reduce) {
    .track { animation: none; width: auto; }
    .set { flex-wrap: wrap; justify-content: center; row-gap: 16px; width: 100%; }
    .set[aria-hidden] { display: none; }
  }
</style>
