---
import { u } from '../lib/url';
import { contact, navigation } from '../data/site';
import { type Lang, lp, tr } from '../i18n';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const annee = new Date().getFullYear();
const t = {
  devise: {
    fr: 'Association des lauréats Jeunes Leaders Marocains. All we do is for our nation.',
    ar: 'جمعية خريجي رواد المغرب الشباب. كل ما نقوم به هو من أجل وطننا.',
  },
  association: { fr: 'Association', ar: 'الجمعية' },
  contact: { fr: 'Contact', ar: 'اتصل بنا' },
  reseaux: { fr: 'Réseaux', ar: 'تابعونا' },
  droits: { fr: 'Tous droits réservés.', ar: 'جميع الحقوق محفوظة.' },
};
---
<footer class="site-footer">
  <div class="wrap">
    <div class="foot">
      <div class="f-brand">
        <img src={u("/logos/jlm-alumni-blanc.png")} alt="JLM Alumni" width="1117" height="507" loading="lazy" />
        <p>{tr(t.devise, lang)}</p>
      </div>
      <div>
        <h4>{tr(t.association, lang)}</h4>
        <ul>
          {navigation.map((l) => <li><a href={lp(l.path, lang)}>{tr(l.label, lang)}</a></li>)}
          <li><a href={lp('/contact', lang)}>{tr(t.contact, lang)}</a></li>
        </ul>
      </div>
      <div>
        <h4>{tr(t.contact, lang)}</h4>
        <ul>
          {contact.adresse.map((l) => <li class="muted">{tr(l, lang)}</li>)}
          <li><a href={`mailto:${contact.email}`} dir="ltr">{contact.email}</a></li>
          <li><a href={`tel:${contact.telephoneLien}`} dir="ltr">{contact.telephone}</a></li>
        </ul>
      </div>
      <div>
        <h4>{tr(t.reseaux, lang)}</h4>
        <ul>
          {contact.reseaux.map((r) => <li><a href={r.url} target="_blank" rel="noopener">{r.nom} ↗</a></li>)}
        </ul>
      </div>
    </div>
    <div class="big" aria-hidden="true" dir="ltr">JLM <span>Alumni</span></div>
    <div class="copy">
      <span>© {annee} JLM Alumni. {tr(t.droits, lang)}</span>
      <span class="bars"><i class="bg-green"></i><i class="bg-yellow"></i><i class="bg-red"></i></span>
    </div>
  </div>
</footer>

<style>
  .site-footer { background: var(--ink); color: #fff; padding: 80px 0 32px; margin-top: 96px; }
  .foot { display: grid; grid-template-columns: 1.6fr 1fr 1.3fr 1fr; gap: 40px; }
  .f-brand img { height: 64px; width: auto; margin-bottom: 1.25rem; }
  .f-brand p { color: rgba(255,255,255,.65); max-width: 32ch; }
  h4 { font-size: .8rem; letter-spacing: .1em; text-transform: uppercase; color: rgba(255,255,255,.5); margin-bottom: 1rem; font-weight: 600; }
  :global([lang='ar']) h4 { letter-spacing: 0; font-size: .95rem; }
  li { margin-bottom: .5rem; }
  li a:hover { color: var(--yellow); }
  .muted { color: rgba(255,255,255,.65); }
  .big { font-family: 'Bricolage Grotesque', system-ui, sans-serif; font-weight: 800; font-size: clamp(3.4rem, 14vw, 12rem); letter-spacing: -.05em; line-height: .85; margin-top: 72px; white-space: nowrap; text-align: start; }
  :global([dir='rtl']) .big { text-align: right; }
  .big span { color: var(--green); }
  .copy { display: flex; justify-content: space-between; align-items: center; color: rgba(255,255,255,.5); font-size: .85rem; border-top: 1px solid rgba(255,255,255,.12); padding-top: 20px; margin-top: 24px; gap: 1rem; flex-wrap: wrap; }
  .bars { display: flex; gap: 6px; }
  .bars i { width: 28px; height: 6px; border-radius: 3px; display: block; }
  @media (max-width: 960px) { .foot { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 520px) { .foot { grid-template-columns: 1fr; } }
</style>
