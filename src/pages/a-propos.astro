---
import { u } from '../lib/url';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CtaBlock from '../components/CtaBlock.astro';
import { chiffres } from '../data/site';

const parcours = [
  { n: '01', t: 'Étudiant JLM', d: "Il rejoint JLM dans son école ou son université et monte un projet à impact avec son équipe.", c: 'green' },
  { n: '02', t: 'Porteur de projet', d: 'Il se forme, participe aux bootcamps régionaux et défend son projet à la Compétition nationale.', c: 'yellow' },
  { n: '03', t: 'Lauréat', d: 'Il termine le programme avec un réseau, des compétences et l\'envie de transmettre.', c: 'red' },
  { n: '04', t: 'Alumni engagé', d: 'Il rejoint JLM Alumni pour encadrer la nouvelle génération et agir sur le terrain.', c: 'ink' },
];
const valeurs = [
  { t: 'Engagement citoyen', d: 'Agir concrètement pour son quartier, sa région et son pays.' },
  { t: 'Entrepreneuriat social', d: 'Créer des projets qui répondent à de vrais besoins de la société.' },
  { t: 'Transmission', d: 'Les lauréats d\'hier forment et accompagnent les leaders de demain.' },
  { t: 'Excellence', d: 'Viser haut, se former sans cesse et donner le meilleur de soi.' },
];
---
<Base title="À propos" description="Découvrez JLM Alumni, l'association des lauréats Jeunes Leaders Marocains, son histoire, sa mission et ses valeurs.">
  <PageHero
    badge="Qui sommes-nous"
    titre="Les lauréats JLM,"
    accent="au service du Maroc."
    intro="JLM Alumni rassemble les lauréats du programme Jeunes Leaders Marocains pour prolonger son impact : transmettre, accompagner et agir sur le terrain."
    image="/images/alumni-groupe.jpg"
  />

  <section style="padding-top:24px">
    <div class="wrap story">
      <div class="story-card reveal">
        <span class="year c-green">{chiffres.creationJlm}</span>
        <h3>Jeunes Leaders Marocains</h3>
        <p>JLM est une initiative d'entrepreneuriat social et d'engagement citoyen, 100 % marocaine et à but non lucratif. Elle encadre les étudiants de l'enseignement supérieur public et privé à travers un réseau de {chiffres.ecoles} grandes écoles et universités.</p>
      </div>
      <div class="story-card dark reveal">
        <span class="year c-yellow">{chiffres.creationAlumni}</span>
        <h3>JLM Alumni</h3>
        <p>L'association des lauréats JLM est née pour que l'aventure continue après les études. Elle réunit {chiffres.laureats} lauréats qui mettent leur expérience au service des nouvelles générations et des populations.</p>
      </div>
    </div>
  </section>

  <section class="indh-sec">
    <div class="wrap"><div class="indh reveal">
      <img src={u("/images/partenaires/indh.png")} alt="Initiative Nationale pour le Développement Humain" loading="lazy" />
      <div>
        <span class="pill"><span class="dot"></span>Partenariat institutionnel</span>
        <h2>Aux côtés de l'INDH</h2>
        <p>JLM Alumni est partenaire de l'Initiative Nationale pour le Développement Humain sur l'axe « Amélioration du revenu et inclusion économique des jeunes ». L'association est installée au Complexe Social INDH de Sidi Maarouf, à Casablanca.</p>
      </div>
    </div></div>
  </section>

  <section>
    <div class="wrap">
      <div class="sec-head"><h2>Le parcours d'un lauréat</h2><p>De l'amphi au terrain : comment un étudiant devient un leader engagé.</p></div>
      <ol class="path">
        {parcours.map((p) => (
          <li class="reveal">
            <span class={`n n-${p.c}`}>{p.n}</span>
            <h3>{p.t}</h3>
            <p>{p.d}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <div class="dark-block">
    <div class="wrap" style="padding:0">
      <div class="sec-head"><h2>Nos valeurs</h2><p>« All we do is for our nation » : la devise qui guide chacune de nos actions.</p></div>
      <div class="values">
        {valeurs.map((v, i) => (
          <div class="value reveal">
            <i class={['bg-green', 'bg-yellow', 'bg-red', 'bg-green'][i]}></i>
            <h3>{v.t}</h3>
            <p>{v.d}</p>
          </div>
        ))}
      </div>
    </div>
  </div>

  <section>
    <div class="wrap map reveal">
      <div>
        <h2><span class="c-green">{chiffres.ecoles}</span> établissements, tout le Maroc</h2>
        <p>Casablanca, Rabat, Fès, Marrakech, Agadir, Tanger, Oujda, Laâyoune… JLM est présent dans les grandes écoles et universités de toutes les régions.</p>
      </div>
      <img src={u("/images/carte-ecoles.jpg")} alt="Liste et carte des écoles et universités partenaires" loading="lazy" />
    </div>
  </section>

  <CtaBlock />
</Base>

<style>
  .story { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .story-card { background: var(--soft); border-radius: var(--radius); padding: 40px; }
  .story-card.dark { background: var(--ink); color: #fff; }
  .story-card.dark p { color: rgba(255,255,255,.7); }
  .year { font-family: var(--display); font-weight: 800; font-size: clamp(3.5rem, 7vw, 5.5rem); letter-spacing: -.04em; line-height: 1; }
  .story-card h3 { font-size: 1.8rem; margin: 1rem 0 .75rem; }
  .story-card p { color: var(--muted); font-size: 1.05rem; }

  .indh-sec { padding-top: 0; }
  .indh { display: grid; grid-template-columns: 280px 1fr; gap: 56px; align-items: center; border: 2px solid var(--ink); border-radius: var(--radius); padding: 48px; }
  .indh img { width: 100%; mix-blend-mode: multiply; }
  .indh h2 { font-size: clamp(2rem, 4vw, 3rem); margin: 1rem 0; }
  .indh p { color: var(--muted); font-size: 1.05rem; max-width: 60ch; }

  .path { list-style: none; display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; counter-reset: none; }
  .path li { border-top: 3px solid var(--ink); padding-top: 24px; }
  .n { display: inline-grid; place-items: center; width: 56px; height: 56px; border-radius: 50%; font-family: var(--display); font-weight: 800; font-size: 1.1rem; }
  .n-green { background: var(--green); color: #fff; }
  .n-yellow { background: var(--yellow); }
  .n-red { background: var(--red); color: #fff; }
  .n-ink { background: var(--ink); color: #fff; }
  .path h3 { font-size: 1.6rem; margin: 1.25rem 0 .5rem; }
  .path p { color: var(--muted); }

  .values { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
  .value { background: var(--ink-2); border-radius: 24px; padding: 28px; }
  .value i { display: block; width: 40px; height: 8px; border-radius: 4px; margin-bottom: 1.5rem; }
  .value h3 { font-size: 1.5rem; margin-bottom: .5rem; }
  .value p { color: rgba(255,255,255,.65); }

  .map { display: grid; grid-template-columns: 1fr 1.2fr; gap: 56px; align-items: center; }
  .map p { color: var(--muted); font-size: 1.1rem; margin-top: 1rem; max-width: 44ch; }
  .map img { border-radius: var(--radius); border: 1px solid var(--line); }

  @media (max-width: 960px) {
    .story, .map { grid-template-columns: 1fr; }
    .indh { grid-template-columns: 1fr; padding: 32px 24px; gap: 24px; }
    .indh img { max-width: 200px; }
    .path, .values { grid-template-columns: 1fr 1fr; }
    .story-card { padding: 28px; }
  }
  @media (max-width: 520px) { .path, .values { grid-template-columns: 1fr; } }
</style>
