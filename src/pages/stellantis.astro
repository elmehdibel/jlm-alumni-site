---
import Base from '../layouts/Base.astro';
import InscriptionForm from '../components/InscriptionForm.astro';
import { u } from '../lib/url';
import { formulaires } from '../data/site';

const img = (p: string) => u(`/images/stellantis/${p}`);

const dsff = {
  stats: [
    { v: '120', l: 'jeunes formés par an', c: 'green' },
    { v: '180 h', l: 'de formation par participant', c: 'yellow' },
    { v: '≥ 30 %', l: 'de femmes', c: 'red' },
    { v: '≥ 50 %', l: 'insérés en stage', c: 'ink' },
  ],
  parcours: [
    { t: 'Tronc commun', h: '90 h', c: 'green', items: ['Écoute et orientation', 'Soft skills, avec un psychologue', 'Bureautique', 'Digital branding'] },
    { t: 'Spécialisation', h: '60 h', c: 'yellow', items: ['Intelligence artificielle et automatisation', 'Techniques de vente', 'Logistique et gestion des stocks'] },
    { t: 'Bootcamps & ateliers', h: '30 h', c: 'red', items: ['Mini-projets', 'Employabilité', 'Sécurité au travail'] },
  ],
  etapes: [
    { t: 'Recrutement', d: 'Appel à candidatures sur plusieurs canaux et sélection de la cohorte.' },
    { t: 'Formation', d: '180 heures : tronc commun, spécialisation, bootcamps et ateliers pratiques.' },
    { t: 'Suivi', d: 'Suivi pédagogique, bilans trimestriels et accompagnement contre le décrochage.' },
    { t: 'Insertion', d: 'Mise en relation avec les entreprises partenaires et stages.' },
  ],
};

const dsu = {
  stats: [
    { v: '100', l: 'jeunes accompagnés', c: 'green' },
    { v: '18–35', l: 'ans', c: 'yellow' },
    { v: '45 h', l: 'de formation', c: 'red' },
    { v: '6 mois', l: "d'incubation et coworking", c: 'green' },
    { v: '30', l: 'start-up créées', c: 'yellow' },
    { v: '≥ 35 %', l: 'de femmes', c: 'red' },
  ],
  parcours: [
    { t: 'Fondations & idéation', h: '12 h', c: 'green', items: ["Introduction à l'entrepreneuriat digital", "Identification du problème et validation de l'idée", 'Design thinking et innovation'] },
    { t: 'Stratégie & marché', h: '16 h', c: 'yellow', items: ["Intelligence artificielle appliquée à l'entrepreneuriat", 'Business model et revenus', 'Étude de marché et concurrence', 'Marketing digital et acquisition'] },
    { t: 'Lancement & pitch', h: '17 h', c: 'red', items: ["Développement d'un MVP", 'Gestion financière et prévisions', "Création d'entreprise au Maroc", 'Pitch et préparation au Demo Day'] },
  ],
  etapes: [
    { t: 'Mobilisation', d: 'Cérémonie de lancement, campagnes et appels à candidatures.' },
    { t: 'Sélection', d: 'Analyse des dossiers, entretiens et validation des 100 bénéficiaires.' },
    { t: 'Formation & création', d: '45 h de formation, business plan validé et création juridique de la start-up.' },
    { t: 'Incubation', d: '6 mois de coworking, mentorat, coaching et Demo Day final.' },
  ],
};
const txt: Record<string, string> = { green: '#fff', yellow: 'var(--ink)', red: '#fff', ink: '#fff' };
---
<Base title="Programmes avec Stellantis" description="Digital Skills For Future et Digital Startup Incubation : deux programmes JLM Alumni × Stellantis pour former, insérer et incuber les jeunes au Maroc.">
  <!-- En-tête -->
  <section class="top">
    <div class="wrap">
      <div class="duo">
        <img src={u('/logos/jlm-alumni-couleur.png')} alt="JLM Alumni" />
        <span>×</span>
        <img src={img('logo-stellantis.png')} alt="Stellantis" />
      </div>
      <h1>Deux programmes pour les <span class="c-green">talents</span> et les <span class="c-red">start-up</span> de demain.</h1>
      <p class="lead">Avec le mécénat de Stellantis, JLM Alumni forme les jeunes aux compétences digitales, les accompagne vers l'emploi et incube leurs projets d'entreprise.</p>
      <div class="picks">
        <a href="#dsff" class="pick">
          <img src={img('logo-dsff.png')} alt="Digital Skills For Future" />
          <div><b>Digital Skills For Future</b><span>Formation et insertion professionnelle</span></div>
          <i>→</i>
        </a>
        <a href="#dsu" class="pick">
          <img src={img('logo-dsu.png')} alt="Digital Startup Incubation" />
          <div><b>Digital Startup Incubation</b><span>Formation et incubation de start-up</span></div>
          <i>→</i>
        </a>
      </div>
    </div>
  </section>

  <!-- DSFF -->
  <section id="dsff" class="prog">
    <div class="wrap">
      <div class="intro">
        <div>
          <span class="pill"><span class="dot"></span>Programme 01 · DSFF</span>
          <h2>Digital Skills <span class="c-green">For Future</span></h2>
          <p class="lead">Former, accompagner et insérer chaque année 120 jeunes grâce aux compétences digitales de demain. L'objectif : faire du numérique un vrai levier d'insertion socio-professionnelle.</p>
          <a href="#inscription-dsff" class="btn btn-dark">Je m'inscris →</a>
        </div>
        <div class="stats">
          {dsff.stats.map((s) => <div class="stat reveal" style={`background:var(--${s.c});color:${txt[s.c]}`}><b>{s.v}</b><span>{s.l}</span></div>)}
        </div>
      </div>

      <h3 class="sub">Un parcours de 180 heures</h3>
      <div class="parcours">
        {dsff.parcours.map((p) => (
          <div class="bloc reveal">
            <div class="bloc-head"><span class={`hours bg-${p.c}`}>{p.h}</span><h4>{p.t}</h4></div>
            <ul>{p.items.map((i) => <li>{i}</li>)}</ul>
          </div>
        ))}
      </div>

      <div class="steps">
        {dsff.etapes.map((s, i) => <div class="step reveal"><span>0{i + 1}</span><h4>{s.t}</h4><p>{s.d}</p></div>)}
      </div>

      <div class="photos">
        <img src={img('dsff-1.jpg')} alt="Séance de formation Digital Skills For Future" loading="lazy" />
        <img src={img('dsff-2.jpg')} alt="Atelier sur ordinateur" loading="lazy" />
        <img src={img('dsff-partenariat.jpg')} alt="Signature d'un partenariat d'insertion" loading="lazy" />
      </div>
      <p class="partners-note"><b>Partenaires d'insertion :</b> Mikafric, ManpowerGroup et le Centre Américain accompagnent les bénéficiaires vers les stages et l'emploi.</p>

      <div id="inscription-dsff" class="form-zone">
        <div class="form-side">
          <span class="pill"><span class="dot"></span>Inscriptions</span>
          <h3>Rejoins la prochaine cohorte DSFF</h3>
          <p>Remplis le formulaire : l'équipe JLM Alumni te recontacte pour la suite de la sélection.</p>
        </div>
        <InscriptionForm programme="dsff" endpoint={formulaires.dsff} titre="Inscription DSFF" sujet="Inscription Digital Skills For Future" />
      </div>
    </div>
  </section>

  <!-- DSU -->
  <section id="dsu" class="prog-dark">
    <div class="dark-block">
      <div class="wrap" style="padding:0">
        <div class="intro">
          <div>
            <span class="pill dark-pill"><span class="dot" style="background:var(--red)"></span>Programme 02 · DSU</span>
            <h2>Digital Startup <span class="c-red">Incubation</span></h2>
            <p class="lead">Former, accompagner et incuber les jeunes entrepreneurs jusqu'à la création effective de leur start-up. Un parcours complet : formation, création juridique et 6 mois d'incubation.</p>
            <p class="small">Programme de formation conçu avec le Laboratoire Pluridisciplinaire de Recherche et d'Innovation (LPRI) de l'EMSI.</p>
            <a href="#inscription-dsu" class="btn btn-white">Je candidate →</a>
          </div>
          <div class="stats six">
            {dsu.stats.map((s) => <div class="stat reveal" style={`background:var(--${s.c});color:${txt[s.c]}`}><b>{s.v}</b><span>{s.l}</span></div>)}
          </div>
        </div>

        <h3 class="sub">45 heures de formation, 11 modules</h3>
        <div class="parcours">
          {dsu.parcours.map((p) => (
            <div class="bloc reveal">
              <div class="bloc-head"><span class={`hours bg-${p.c}`}>{p.h}</span><h4>{p.t}</h4></div>
              <ul>{p.items.map((i) => <li>{i}</li>)}</ul>
            </div>
          ))}
        </div>

        <div class="steps">
          {dsu.etapes.map((s, i) => <div class="step reveal"><span>0{i + 1}</span><h4>{s.t}</h4><p>{s.d}</p></div>)}
        </div>

        <div class="photos four">
          <img src={img('dsu-1.jpg')} alt="Premier groupe Digital Startup Incubation en formation" loading="lazy" />
          <img src={img('dsu-4.jpg')} alt="Module d'initiation à l'intelligence artificielle" loading="lazy" />
          <img src={img('dsu-2.jpg')} alt="Atelier en groupe" loading="lazy" />
          <img src={img('dsu-3.jpg')} alt="Échanges entre participants" loading="lazy" />
        </div>

        <div id="inscription-dsu" class="form-zone">
          <div class="form-side">
            <span class="pill dark-pill"><span class="dot" style="background:var(--yellow)"></span>Candidatures</span>
            <h3>Tu as une idée de start-up ?</h3>
            <p>Tu as entre 18 et 35 ans et un projet innovant ? Candidate : la sélection se fait sur la motivation, la pertinence de l'idée et l'engagement citoyen.</p>
          </div>
          <InscriptionForm programme="dsu" endpoint={formulaires.dsu} titre="Candidature DSU" sujet="Candidature Digital Startup Incubation" sombre />
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .top { padding: 48px 0 32px; }
  .duo { display: flex; align-items: center; gap: 18px; margin-bottom: 28px; }
  .duo img { height: 54px; width: auto; }
  .duo span { font-family: var(--display); font-size: 1.8rem; font-weight: 800; color: var(--muted); }
  h1 { font-size: clamp(2.6rem, 6.2vw, 5.4rem); max-width: 16ch; }
  .lead { font-size: 1.15rem; color: var(--muted); max-width: 56ch; margin: 1.25rem 0 1.75rem; }
  .picks { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-top: 2rem; }
  .pick { display: grid; grid-template-columns: 130px 1fr auto; align-items: center; gap: 20px; border: 2px solid var(--line); border-radius: var(--radius); padding: 20px 24px; transition: .25s; }
  .pick:hover { border-color: var(--ink); transform: translateY(-3px); }
  .pick img { width: 130px; height: 76px; object-fit: contain; }
  .pick b { display: block; font-family: var(--display); font-size: 1.35rem; letter-spacing: -.02em; }
  .pick span { color: var(--muted); font-size: .92rem; }
  .pick i { font-style: normal; font-size: 1.4rem; font-weight: 700; }

  .prog { padding: 72px 0 96px; scroll-margin-top: 84px; }
  .prog-dark { padding: 0 0 24px; scroll-margin-top: 84px; }
  .intro { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: center; }
  .intro h2 { margin: 1.1rem 0 0; }
  .prog-dark .lead, .prog-dark .small { color: rgba(255,255,255,.7); }
  .small { font-size: .9rem; margin: -0.5rem 0 1.75rem; max-width: 52ch; }
  .dark-pill { background: #222; color: #fff; }

  .stats { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .stats.six { grid-template-columns: repeat(3, 1fr); }
  .stat { border-radius: 24px; padding: 22px; min-height: 140px; display: flex; flex-direction: column; justify-content: space-between; }
  .stat b { font-family: var(--display); font-weight: 800; font-size: clamp(2rem, 3.6vw, 3rem); letter-spacing: -.04em; line-height: 1; white-space: nowrap; }
  .stats.six .stat b { font-size: clamp(1.8rem, 2.8vw, 2.5rem); }
  .stat span { font-weight: 500; font-size: .92rem; }

  .sub { font-size: clamp(1.7rem, 3vw, 2.4rem); margin: 72px 0 24px; }
  .parcours { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .bloc { background: var(--soft); border-radius: 24px; padding: 28px; }
  .prog-dark .bloc { background: var(--ink-2); }
  .bloc-head { display: flex; align-items: center; gap: 14px; margin-bottom: 18px; }
  .hours { font-family: var(--display); font-weight: 800; font-size: 1.1rem; padding: .45rem .8rem; border-radius: 12px; white-space: nowrap; }
  .hours.bg-yellow { color: var(--ink); }
  .bloc h4 { font-family: var(--display); font-size: 1.3rem; letter-spacing: -.02em; line-height: 1.1; }
  .bloc li { padding: 10px 0; border-top: 1px solid var(--line); font-weight: 500; }
  .prog-dark .bloc li { border-color: rgba(255,255,255,.1); color: rgba(255,255,255,.85); }

  .steps { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-top: 40px; }
  .step { border-top: 3px solid currentColor; padding-top: 18px; }
  .step span { font-family: var(--display); font-weight: 800; color: var(--green); font-size: 1.1rem; }
  .prog-dark .step span { color: var(--yellow); }
  .step h4 { font-family: var(--display); font-size: 1.35rem; margin: .4rem 0; letter-spacing: -.02em; }
  .step p { color: var(--muted); font-size: .95rem; }
  .prog-dark .step p { color: rgba(255,255,255,.65); }

  .photos { display: grid; grid-template-columns: 1.4fr 1fr 1fr; gap: 12px; margin-top: 56px; }
  .photos.four { grid-template-columns: 1.5fr 1fr 1fr 1fr; }
  .photos img { width: 100%; height: 280px; object-fit: cover; border-radius: 20px; }
  .partners-note { margin-top: 20px; color: var(--muted); }

  .form-zone { display: grid; grid-template-columns: .8fr 1.2fr; gap: 48px; align-items: start; margin-top: 72px; scroll-margin-top: 100px; }
  .form-side { position: sticky; top: 108px; }
  .form-side h3 { font-size: clamp(2rem, 4vw, 3rem); margin: 1rem 0; }
  .form-side p { color: var(--muted); font-size: 1.05rem; }
  .prog-dark .form-side p { color: rgba(255,255,255,.7); }

  @media (max-width: 960px) {
    .picks, .intro, .form-zone { grid-template-columns: 1fr; }
    .parcours { grid-template-columns: 1fr; }
    .steps { grid-template-columns: 1fr 1fr; }
    .stats.six { grid-template-columns: 1fr 1fr; }
    .photos, .photos.four { grid-template-columns: 1fr 1fr; }
    .photos img { height: 200px; }
    .photos img:first-child { grid-column: span 2; }
    .photos.four img:first-child { grid-column: span 2; }
    .form-side { position: static; }
    .sub { margin-top: 56px; }
  }
  @media (max-width: 520px) {
    .pick { grid-template-columns: 90px 1fr; padding: 16px; }
    .pick img { width: 90px; height: 56px; }
    .pick i { display: none; }
    .duo img { height: 40px; }
    .steps { grid-template-columns: 1fr; }
    .stat { min-height: 120px; padding: 18px; }
  }
</style>
