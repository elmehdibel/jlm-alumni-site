---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import { partenaires, contact, chiffres } from '../../data/site';
import { getLang, langPaths, tr } from '../../i18n';
import { tailleLogo } from '../../lib/logo';

export const getStaticPaths = langPaths;
const lang = getLang(Astro.params.lang);
const institutions = partenaires.filter((p) => p.type === 'institution');
const entreprises = partenaires.filter((p) => p.type === 'entreprise');
const T = {
  fr: {
    title: 'Partenaires', desc: 'Institutions et entreprises qui soutiennent JLM Alumni, et comment devenir partenaire.',
    badge: 'Ils nous font confiance', titre: 'Ensemble pour', accent: 'la jeunesse.',
    intro: 'Institutions publiques et entreprises engagées : nos partenaires rendent possibles nos programmes et nos événements partout au Maroc.',
    inst: 'Partenaires institutionnels', ent: 'Entreprises partenaires',
    devH: 'Devenir partenaire', devTxt: 'Soutenez un programme, un événement ou la saison entière. Nous construisons ensemble un partenariat sur mesure.',
    raisons: [
      ['Visibilité', `Votre marque auprès de ${chiffres.etudiants} étudiants et de ${chiffres.ecoles} écoles et universités.`],
      ['Talents', 'Un accès privilégié aux jeunes leaders les plus engagés du pays.'],
      ['Impact', "Une contribution concrète et mesurable à l'inclusion économique des jeunes."],
    ],
    proposer: 'Proposer un partenariat →', appel: 'ou appelez-nous au',
  },
  ar: {
    title: 'شركاؤنا', desc: 'المؤسسات والمقاولات التي تدعم JLM Alumni، وكيف تصبح شريكًا.',
    badge: 'يثقون بنا', titre: 'معًا من أجل', accent: 'الشباب.',
    intro: 'مؤسسات عمومية ومقاولات ملتزمة: شركاؤنا يجعلون برامجنا وفعالياتنا ممكنة في جميع أنحاء المغرب.',
    inst: 'الشركاء المؤسساتيون', ent: 'المقاولات الشريكة',
    devH: 'كن شريكًا', devTxt: 'ادعم برنامجًا أو فعالية أو الموسم بأكمله. نبني معًا شراكة على المقاس.',
    raisons: [
      ['الإشعاع', `علامتك التجارية أمام ${chiffres.etudiants} طالب و${chiffres.ecoles} مدرسة وجامعة.`],
      ['المواهب', 'ولوج مميز إلى أكثر الشباب القادة التزامًا في البلاد.'],
      ['الأثر', 'مساهمة ملموسة وقابلة للقياس في الإدماج الاقتصادي للشباب.'],
    ],
    proposer: 'اقترح شراكة ←', appel: 'أو اتصل بنا على',
  },
}[lang];
const couleurs = ['green', 'yellow', 'red'];
const mail = `mailto:${contact.email}?subject=${encodeURIComponent('Partenariat JLM Alumni')}`;
---
<Base title={T.title} description={T.desc} lang={lang}>
  <PageHero badge={T.badge} titre={T.titre} accent={T.accent} intro={T.intro} image="/images/remise-prix.jpg" />

  <section style="padding-top:24px">
    <div class="wrap">
      <h2 class="sub">{T.inst}</h2>
      <div class="logos">
        {institutions.map((p) => <div class="logo reveal"><span class="cadre" style={tailleLogo(p.ratio, 7000, 84, 170)}><img src={p.logo} alt={tr(p.nom, lang)} loading="lazy" /></span><span>{tr(p.nom, lang)}</span></div>)}
      </div>
      <h2 class="sub">{T.ent}</h2>
      <div class="logos">
        {entreprises.map((p) => <div class="logo reveal"><span class="cadre" style={tailleLogo(p.ratio, 7000, 84, 170)}><img src={p.logo} alt={tr(p.nom, lang)} loading="lazy" /></span><span>{tr(p.nom, lang)}</span></div>)}
      </div>
    </div>
  </section>

  <div class="dark-block" id="devenir-partenaire">
    <div class="wrap" style="padding:0">
      <div class="sec-head"><h2>{T.devH}</h2><p>{T.devTxt}</p></div>
      <div class="why">
        {T.raisons.map(([t, d], i) => (
          <div class="reveal">
            <i class={`bg-${couleurs[i]}`}></i>
            <h3>{t}</h3>
            <p>{d}</p>
          </div>
        ))}
      </div>
      <div class="contact-row">
        <a href={mail} class="btn btn-white">{T.proposer}</a>
        <span>{T.appel} <a href={`tel:${contact.telephoneLien}`} dir="ltr">{contact.telephone}</a></span>
      </div>
    </div>
  </div>
</Base>

<style>
  .sub { font-size: clamp(1.6rem, 3vw, 2.2rem); margin: 48px 0 20px; }
  .sub:first-child { margin-top: 0; }
  .logos { display: grid; grid-template-columns: repeat(4, 1fr); grid-auto-rows: 1fr; gap: 12px; }
  .logo { border: 1px solid var(--line); border-radius: 24px; min-height: 190px; display: grid; grid-template-rows: 1fr auto; justify-items: center; align-items: center; gap: 14px; padding: 24px; transition: .25s; min-width: 0; }
  .logo:hover { border-color: var(--ink); transform: translateY(-4px); }
  .cadre { display: block; width: min(var(--w), 100%); aspect-ratio: var(--r); flex: none; }
  .cadre img { display: block; width: 100%; height: 100%; object-fit: contain; }
  .logo > span:last-child { font-size: .85rem; color: var(--muted); font-weight: 500; text-align: center; }

  .why { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .why div { background: var(--ink-2); border-radius: 24px; padding: 32px; }
  .why i { display: block; width: 40px; height: 8px; border-radius: 4px; margin-bottom: 1.5rem; }
  .why h3 { font-size: 1.8rem; margin-bottom: .5rem; }
  .why p { color: rgba(255,255,255,.7); }
  .contact-row { display: flex; align-items: center; gap: 24px; margin-top: 40px; flex-wrap: wrap; color: rgba(255,255,255,.7); }
  .contact-row a:not(.btn) { color: var(--yellow); font-weight: 600; }

  @media (max-width: 960px) {
    .logos { grid-template-columns: repeat(2, 1fr); }
    .why { grid-template-columns: 1fr; }
  }
</style>
