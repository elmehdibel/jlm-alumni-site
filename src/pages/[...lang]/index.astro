---
import { u } from '../../lib/url';
import Base from '../../layouts/Base.astro';
import PartnersMarquee from '../../components/PartnersMarquee.astro';
import CtaBlock from '../../components/CtaBlock.astro';
import CarteReseau from '../../components/CarteReseau.astro';
import { chiffres, programmes, saison, reseau } from '../../data/site';
import { getLang, langPaths, lp, tr } from '../../i18n';

export const getStaticPaths = langPaths;
const lang = getLang(Astro.params.lang);
const equipes = reseau.reduce((n, v) => n + v.ecoles.length, 0);
const ans = new Date().getFullYear() - Number(chiffres.creationJlm);
const txt = { green: '#fff', yellow: 'var(--ink)', red: '#fff' } as const;
const f = lang === 'ar' ? '←' : '→';
const T = {
  fr: {
    pill: `Depuis ${chiffres.creationJlm} · 100 % marocaine`,
    h1: ['Jeunes.', 'Leaders.', 'Marocains.'],
    intro: 'Le réseau des lauréats JLM. On forme, on oriente et on agit sur le terrain pour que chaque jeune puisse entreprendre pour le Maroc.',
    programmes: 'Nos programmes', partenaire: 'Devenir partenaire',
    alts: ["Lauréates JLM sur scène lors d'une remise de prix", 'Équipe JLM recevant un trophée', 'Célébration lors de la compétition nationale', "Foule d'étudiants à la compétition nationale JLM"],
    sticker: [`${ans} ans`, "d'impact"],
    mission: 'Notre mission', devise: 'All we do is for our nation.',
    missionTxt: "Une initiative 100 % marocaine, à but non lucratif, partenaire de l'INDH pour l'inclusion économique des jeunes.",
    decouvrir: "Découvrir l'association",
    tiles: ['Étudiants formés', 'Équipes actives', 'Lauréats Alumni', 'Bénéficiaires'],
    progTxt: 'Trois façons concrètes de faire grandir la jeunesse marocaine, portées par nos lauréats bénévoles.',
    saison: 'La saison JLM', saisonTxt: "De la rentrée à la finale, trois rendez-vous qui rassemblent des milliers d'étudiants.",
  },
  ar: {
    pill: `منذ ${chiffres.creationJlm} · مبادرة مغربية 100%`,
    h1: ['رواد.', 'المغرب.', 'الشباب.'],
    intro: 'شبكة خريجي JLM. نُكوّن ونوجّه ونعمل في الميدان حتى يتمكن كل شاب من المبادرة من أجل المغرب.',
    programmes: 'برامجنا', partenaire: 'كن شريكًا',
    alts: ['خريجات JLM على المنصة خلال حفل توزيع الجوائز', 'فريق JLM يتسلم كأس التتويج', 'احتفال خلال المسابقة الوطنية', 'حشد من الطلبة في المسابقة الوطنية لـ JLM'],
    sticker: [`${ans} سنة`, 'من الأثر'],
    mission: 'مهمتنا', devise: 'كل ما نقوم به هو من أجل وطننا.',
    missionTxt: 'مبادرة مغربية 100%، غير ربحية، وشريكة للمبادرة الوطنية للتنمية البشرية من أجل الإدماج الاقتصادي للشباب.',
    decouvrir: 'اكتشف الجمعية',
    tiles: ['طلبة مُكوَّنون', 'فرق نشيطة', 'خريجو JLM', 'مستفيدون'],
    progTxt: 'ثلاث طرق ملموسة لتنمية الشباب المغربي، يحملها خريجونا المتطوعون.',
    saison: 'موسم JLM', saisonTxt: 'من الدخول الجامعي إلى النهائي، ثلاث محطات تجمع آلاف الطلبة.',
  },
}[lang];
---
<Base lang={lang}>
  <div class="wrap hero">
    <div>
      <span class="pill"><span class="dot"></span>{T.pill}</span>
      <h1><span class="c-green">{T.h1[0]}</span><br /><span class="c-yellow">{T.h1[1]}</span><br /><span class="c-red">{T.h1[2]}</span></h1>
      <p>{T.intro}</p>
      <div class="ctas">
        <a href={lp('/programmes', lang)} class="btn btn-dark">{T.programmes} {f}</a>
        <a href={lp('/partenaires', lang) + '#devenir-partenaire'} class="btn btn-line">{T.partenaire}</a>
      </div>
    </div>
    <div class="bento">
      <img class="b1" src={u("/images/groupe-scene.jpg")} alt={T.alts[0]} />
      <img src={u("/images/trophee.jpg")} alt={T.alts[1]} />
      <img src={u("/images/celebration.jpg")} alt={T.alts[2]} />
      <img class="b4" src={u("/images/competition-foule.jpg")} alt={T.alts[3]} />
      <div class="sticker"><div><b>{T.sticker[0]}</b>{T.sticker[1]}</div></div>
    </div>
  </div>

  <PartnersMarquee lang={lang} />

  <section>
    <div class="wrap stats">
      <div class="tile t-dark reveal">
        <span class="pill" style="background:#222;color:#fff;align-self:flex-start"><span class="dot" style="background:var(--yellow)"></span>{T.mission}</span>
        <div>
          <h3>{T.devise}</h3>
          <p>{T.missionTxt}</p>
          <a href={lp('/a-propos', lang)} class="more">{T.decouvrir} {f}</a>
        </div>
      </div>
      <div class="tile bg-green reveal"><span>{T.tiles[0]}</span><b>{chiffres.etudiants}</b></div>
      <div class="tile bg-yellow reveal"><span>{T.tiles[1]}</span><b>{equipes}</b></div>
      <div class="tile t-soft reveal"><span>{T.tiles[2]}</span><b>{chiffres.laureats}</b></div>
      <div class="tile bg-red reveal"><span>{T.tiles[3]}</span><b>{tr(chiffres.beneficiaires, lang)}</b></div>
    </div>
  </section>

  <CarteReseau lang={lang} />

  <section style="padding-top:0">
    <div class="wrap">
      <div class="sec-head"><h2>{T.programmes}</h2><p>{T.progTxt}</p></div>
      <div class="progs">
        {programmes.map((p, i) => (
          <a class="prog reveal" href={lp('/programmes', lang) + `#${p.id}`}>
            <img src={p.image} alt="" loading="lazy" />
            <span class="num" style={`background:var(--${p.couleur});color:${txt[p.couleur as keyof typeof txt]}`}>0{i + 1}</span>
            <div><h3>{tr(p.nom, lang)}</h3><p>{tr(p.resume, lang)}</p></div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <div class="dark-block">
    <div class="wrap" style="padding:0">
      <div class="sec-head"><h2>{T.saison}</h2><p>{T.saisonTxt}</p></div>
      <div class="ev">
        {saison.map((s) => (
          <a class="ev-card reveal" href={lp('/evenements', lang)}>
            <img src={s.image} alt="" loading="lazy" />
            <div>
              <span class="when" style={`background:var(--${s.couleur});color:${txt[s.couleur as keyof typeof txt]}`}>{tr(s.quand, lang)}</span>
              <h3>{tr(s.nom, lang)}</h3>
              <p>{tr(s.texte, lang)}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </div>

  <div style="height:96px"></div>
  <CtaBlock lang={lang} />
</Base>

<style>
  .hero { display: grid; grid-template-columns: 1.05fr 1fr; gap: 48px; align-items: center; padding-top: 48px; padding-bottom: 72px; }
  .hero h1 { font-size: clamp(3rem, 7.4vw, 6.4rem); margin: 1.25rem 0; }
  .hero p { font-size: 1.15rem; color: var(--muted); max-width: 46ch; }
  .ctas { display: flex; gap: .75rem; margin-top: 2rem; flex-wrap: wrap; }
  .bento { display: grid; grid-template-columns: 1fr 1fr; grid-template-rows: 200px 200px 160px; gap: 12px; position: relative; }
  .bento img { width: 100%; height: 100%; object-fit: cover; border-radius: 24px; }
  .bento .b1 { grid-row: span 2; }
  .bento .b4 { grid-column: span 2; }
  .sticker { position: absolute; top: -18px; right: -10px; width: 120px; height: 120px; border-radius: 50%; background: var(--yellow); display: grid; place-items: center; text-align: center; font-family: var(--display); font-weight: 800; line-height: 1.05; transform: rotate(12deg); box-shadow: 0 10px 30px rgba(0,0,0,.15); animation: spin-in 1s ease both .3s; }
  .sticker b { font-size: 1.6rem; display: block; }
  @keyframes spin-in { from { transform: rotate(-30deg) scale(.5); opacity: 0; } }

  .stats { display: grid; grid-template-columns: 1.3fr 1fr 1fr; grid-auto-rows: minmax(180px, auto); gap: 14px; }
  .tile { border-radius: var(--radius); padding: 28px; display: flex; flex-direction: column; justify-content: space-between; }
  .tile b { font-family: var(--display); font-size: clamp(2.6rem, 5vw, 4rem); font-weight: 800; letter-spacing: -.04em; line-height: 1; }
  .tile span { font-weight: 500; }
  .t-dark { background: var(--ink); color: #fff; grid-row: span 2; }
  .t-dark h3 { font-size: 2.2rem; }
  .t-dark p { opacity: .75; font-size: 1.05rem; margin: 1rem 0 1.5rem; }
  .more { font-weight: 600; color: var(--yellow); }
  .t-soft { background: var(--soft); }

  .progs { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .prog { border-radius: var(--radius); overflow: hidden; position: relative; min-height: 440px; display: flex; align-items: flex-end; color: #fff; isolation: isolate; }
  .prog img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: -2; transition: .5s; }
  .prog::before { content: ""; position: absolute; inset: 0; z-index: -1; background: linear-gradient(0deg, rgba(0,0,0,.85), rgba(0,0,0,0) 60%); }
  .prog:hover img { transform: scale(1.05); }
  .prog div { padding: 28px; }
  .prog h3 { font-size: 2rem; margin-bottom: .5rem; }
  .prog p { opacity: .85; font-size: .95rem; }
  .num { position: absolute; top: 20px; left: 20px; width: 48px; height: 48px; border-radius: 50%; display: grid; place-items: center; font-family: var(--display); font-weight: 800; }

  .ev { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .ev-card { background: var(--ink-2); border-radius: 24px; padding: 12px; transition: .3s; }
  .ev-card:hover { background: #252825; }
  .ev-card img { height: 220px; width: 100%; object-fit: cover; border-radius: 16px; }
  .ev-card div { padding: 16px 10px 10px; }
  .ev-card h3 { font-size: 1.6rem; margin: .6rem 0 .4rem; }
  .ev-card p { color: rgba(255,255,255,.65); font-size: .95rem; }
  .when { font-size: .8rem; font-weight: 600; padding: .3rem .7rem; border-radius: 999px; display: inline-block; }

  .network { display: grid; grid-template-columns: 1fr 1fr; gap: 56px; align-items: center; }
  .network h2 { margin: 1.25rem 0 1rem; }
  .network p { color: var(--muted); font-size: 1.1rem; margin-bottom: 2rem; max-width: 44ch; }
  .network img { border-radius: var(--radius); border: 1px solid var(--line); }

  @media (max-width: 960px) {
    .hero, .network { grid-template-columns: 1fr; }
    .stats { grid-template-columns: 1fr 1fr; }
    .t-dark { grid-column: span 2; grid-row: auto; }
    .progs, .ev { grid-template-columns: 1fr; }
    .prog { min-height: 360px; }
  }
  @media (max-width: 520px) {
    .bento { grid-template-rows: 150px 150px 120px; }
    .sticker { width: 92px; height: 92px; font-size: .8rem; right: 0; }
    .sticker b { font-size: 1.2rem; }
    .tile { padding: 22px; min-height: 150px; }
    .tile b { font-size: 2.2rem; }
  }
</style>
